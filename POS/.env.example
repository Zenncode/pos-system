# POS System — .env template
# Copy to `.env`:  cp .env.example .env
# NEVER commit `.env`. Prod secrets live in vault only.
# Full key list: POS/credentials.md §4 · POS/deployment.md §4

APP_ENV=development
APP_URL=http://localhost:8000
PORT=8000
DATABASE_URL=postgres://pos_user:CHANGE_ME@localhost:5432/posdb
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_32_PLUS
CURRENCY=PHP
TAX_RATE=0.12
TAX_INCLUSIVE=true
DISCOUNT_THRESHOLD_PCT=10
DISCOUNT_THRESHOLD_AMT=500
LOYALTY_PER_AMOUNT=100
STORE_TIMEZONE=Asia/Manila
SESSION_TIMEOUT_MIN=15
QR_TIMEOUT_SEC=120
CARD_TIMEOUT_SEC=60

# --- Provider sandbox keys (staging) — prod keys in vault only ---
CARD_GATEWAY_KEY=sb_test_***
WALLET_API_KEY=sb_test_***
QR_API_KEY=sb_test_***
SMTP_HOST=smtp.sandbox.test
SMTP_USER=sb_test_***
SMTP_PASS=sb_test_***
SMS_API_KEY=sb_test_***
SMS_SENDER=POS-TEST

# --- Receipt printer ---
PRINTER_NAME=POS-80
RECEIPT_WIDTH_MM=80
