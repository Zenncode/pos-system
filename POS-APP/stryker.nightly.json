{
  "$schema": "https://stryker-mutator.io/schema/stryker-schema.json",
  "mutate": [
    "app/shared/components/ui/Button.tsx",
    "app/shared/components/ui/Modal.tsx",
    "app/shared/components/ui/CartLine.tsx",
    "app/shared/components/ui/ProductTile.tsx",
    "app/shared/components/ui/Select.tsx",
    "app/shared/components/ui/Table.tsx",
    "app/shared/components/ui/Toaster.tsx",
    "app/shared/components/ui/Badge.tsx",
    "app/shared/components/ui/Input.tsx",
    "app/shared/components/ui/Feedback.tsx"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:components"
  },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  },
  "reporters": ["clear-text", "progress", "json"],
  "allowEmpty": false,
  "cleanTempDir": true
}
